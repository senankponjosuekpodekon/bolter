import { Test, TestingModule } from '@nestjs/testing';
import { LoansService } from './loans.service';
import { SupabaseService } from '../supabase/supabase.service';
import { NotificationsService } from '../notifications/notifications.service';
import { AuditLogsService } from '../audit-logs/audit-logs.service';
import { AccountsService } from '../accounts/accounts.service';
import { BadRequestException, NotFoundException } from '@nestjs/common';

describe('LoansService', () => {
  let service: LoansService;
  let supabaseService: SupabaseService;
  let notificationsService: NotificationsService;
  let auditLogsService: AuditLogsService;
  let accountsService: AccountsService;
  let mockAdminClient: any;

  const mockLoan = {
    id: 'loan-123',
    user_id: 'user-123',
    amount: 10000,
    purpose: 'Business',
    status: 'PENDING',
    interest_rate: 5.5,
    term_months: 24,
    created_at: new Date().toISOString(),
  };

  beforeEach(async () => {
    // Create nested mock objects manually instead of using jest.fn().mockReturnValue()
    mockAdminClient = {
      from: jest.fn().mockImplementation(() => ({
        select: jest.fn().mockImplementation(() => ({
          eq: jest.fn().mockImplementation(() => ({
            maybeSingle: jest.fn().mockResolvedValue({
              data: { id: 'user-123', kyc_status: 'VERIFIED' },
              error: null,
            }),
            single: jest.fn().mockResolvedValue({ data: mockLoan, error: null }),
          })),
          in: jest.fn().mockImplementation(() => ({
            eq: jest.fn().mockResolvedValue({ data: [], error: null }),
          })),
        })),
        insert: jest.fn().mockImplementation(() => ({
          select: jest.fn().mockImplementation(() => ({
            single: jest.fn().mockResolvedValue({ data: mockLoan, error: null }),
          })),
        })),
        update: jest.fn().mockImplementation(() => ({
          eq: jest.fn().mockImplementation(() => ({
            select: jest.fn().mockImplementation(() => ({
              single: jest.fn().mockResolvedValue({
                data: { ...mockLoan, status: 'APPROVED' },
                error: null,
              }),
            })),
          })),
        })),
      })),
    };

    const module: TestingModule = await Test.createTestingModule({
      providers: [
        LoansService,
        {
          provide: SupabaseService,
          useValue: {
            getAdminClient: jest.fn().mockReturnValue(mockAdminClient),
          },
        },
        {
          provide: NotificationsService,
          useValue: {
            notifyLoanCreated: jest.fn(),
            notifyLoanApproved: jest.fn(),
            notifyLoanRejected: jest.fn(),
          },
        },
        {
          provide: AuditLogsService,
          useValue: {
            log: jest.fn(),
          },
        },
        {
          provide: AccountsService,
          useValue: {
            findById: jest.fn().mockResolvedValue({ id: 'acc-123', user_id: 'user-123' }),
          },
        },
      ],
    }).compile();

    service = module.get<LoansService>(LoansService);
    supabaseService = module.get<SupabaseService>(SupabaseService);
    notificationsService = module.get<NotificationsService>(NotificationsService);
    auditLogsService = module.get<AuditLogsService>(AuditLogsService);
    accountsService = module.get<AccountsService>(AccountsService);
  });

  afterEach(() => {
    jest.clearAllMocks();
  });

  describe('createLoan', () => {
    it('should create a loan request successfully', async () => {
      const createLoanDto = {
        amount: 10000,
        purpose: 'Business',
        durationMonths: 24,
        monthlyIncome: 5000,
      };

      mockAdminClient.from.mockReturnValue({
        insert: jest.fn().mockReturnValue({
          select: jest.fn().mockReturnValue({
            single: jest.fn().mockResolvedValue({ data: mockLoan, error: null }),
          }),
        }),
      });

      const result = await service.createLoan('user-123', createLoanDto);

      expect(result).toEqual(mockLoan);
      expect(notificationsService.notifyLoanCreated).toHaveBeenCalledWith({
        loanId: 'loan-123',
        userId: 'user-123',
        amount: 10000,
      });
    });

    it('should throw BadRequestException on creation failure', async () => {
      mockAdminClient.from.mockReturnValue({
        insert: jest.fn().mockReturnValue({
          select: jest.fn().mockReturnValue({
            single: jest.fn().mockResolvedValue({
              data: null,
              error: { message: 'Creation failed' },
            }),
          }),
        }),
      });

      await expect(
        service.createLoan('user-123', {
          amount: 10000,
          purpose: 'Business',
          durationMonths: 24,
          monthlyIncome: 5000,
        })
      ).rejects.toThrow(BadRequestException);
    });
  });

  describe('approveLoan', () => {
    it('should approve a loan successfully', async () => {
      mockAdminClient.from.mockReturnValue({
        update: jest.fn().mockReturnValue({
          eq: jest.fn().mockReturnValue({
            select: jest.fn().mockReturnValue({
              single: jest.fn().mockResolvedValue({
                data: { ...mockLoan, status: 'APPROVED' },
                error: null,
              }),
            }),
          }),
        }),
      });

      const result = await service.approveLoan('admin-123', 'loan-123', { approvalNotes: 'Approved' });

      expect(result.status).toBe('APPROVED');
      expect(notificationsService.notifyLoanApproved).toHaveBeenCalled();
      expect(auditLogsService.log).toHaveBeenCalledWith({
        userId: 'admin-123',
        action: 'LOAN_APPROVED',
        resource: 'LOAN',
        resourceId: 'loan-123',
        metadata: expect.any(Object),
      });
    });
  });

  describe('rejectLoan', () => {
    it('should reject a loan with reason', async () => {
      mockAdminClient.from.mockReturnValue({
        update: jest.fn().mockReturnValue({
          eq: jest.fn().mockReturnValue({
            select: jest.fn().mockReturnValue({
              single: jest.fn().mockResolvedValue({
                data: { ...mockLoan, status: 'REJECTED', rejection_reason: 'Insufficient income' },
                error: null,
              }),
            }),
          }),
        }),
      });

      const result = await service.rejectLoan('loan-123', 'admin-123', { reason: 'Insufficient income' });

      expect(result.status).toBe('REJECTED');
      expect(notificationsService.notifyLoanRejected).toHaveBeenCalled();
    });
  });
});
