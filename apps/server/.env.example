# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=3600
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
JWT_REFRESH_EXPIRATION=2592000
JWT_REFRESH_EXPIRES_IN=2592000

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173

# White-label / Branding
APP_NAME=My Banking App
APP_SUPPORT_EMAIL=support@mybank.com
APP_LOGO_URL=https://mybank.com/logo.png
APP_PRIMARY_COLOR=#2563eb

# Email Configuration
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM=notifications@banking-platform.test


# Exchange Rate Provider (optional — falls back to static rates when unset)
# Option A: exchangerate-api.com key → https://v6.exchangerate-api.com/v6/<key>
# EXCHANGE_RATE_API_KEY=
# Option B: any "latest rates" endpoint, e.g. https://open.er-api.com/v6/latest (no key needed)
# EXCHANGE_RATE_API_URL=
# EXCHANGE_RATE_CACHE_TTL_MS=3600000
# EXCHANGE_RATE_TIMEOUT_MS=5000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Frontend Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
