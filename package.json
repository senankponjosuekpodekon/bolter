{
  "name": "banking-platform",
  "version": "1.0.0",
  "description": "Complete banking platform with client, admin and server",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run start:dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:admin": "npm run dev --workspace=admin",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:admin\"",
    "tunnel": "node scripts/ngrok.js",
    "tunnel:cli": "./scripts/ngrok-cli.sh",
    "tunnel:client": "./scripts/ngrok-cli.sh client",
    "tunnel:api": "./scripts/ngrok-cli.sh api",
    "tunnel:admin": "./scripts/ngrok-cli.sh admin",
    "tunnel:all": "./scripts/ngrok-cli.sh all",
    "start:all": "./scripts/start-all.sh",
    "start:admin-ngrok": "./scripts/start-with-admin.sh",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:admin": "npm run build --workspace=admin",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:staged": "jest --bail --findRelatedTests",
    "test:coverage": "npm run test --workspaces -- --coverage",
    "test:watch": "npm run test --workspaces -- --watch",
    "lint": "npm run lint --workspace=client && npm run lint --workspace=server && npm run lint --workspace=admin",
    "lint:fix": "npm run lint --workspaces -- --fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css}\" \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,css}\" \"src/**/*.{ts,js,json}\"",
    "e2e": "npm run e2e --workspace=client",
    "e2e:ui": "npm run e2e:ui --workspace=client",
    "security:audit": "npm audit --production",
    "security:audit:fix": "npm audit fix",
    "prepare": "command -v husky > /dev/null 2>&1 && husky install || true",
    "ci:all": "npm run lint && npm run test:coverage && npm run build && npm run e2e"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "ngrok": "^5.0.0-beta.2"
  },
  "dependencies": {
    "eslint-plugin-react": "^7.37.5",
    "nodemailer": "^7.0.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "typescript": "^5.9.3"
  }
}
