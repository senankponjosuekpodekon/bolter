# Ngrok Configuration for Banking Platform
# Copy to ngrok.yml (gitignored) and set NGROK_AUTH_TOKEN in your .env,
# or configure globally once: ngrok config add-authtoken <TOKEN>
# Usage: ngrok start --config=ngrok.yml client

version: "3"
agent:
  authtoken: ${NGROK_AUTH_TOKEN}

# Tunnel pour le client frontend (port 5173)
tunnels:
  client:
    proto: http
    addr: 5173
    schemes: [https]

  # Tunnel pour l'API backend (port 3000)
  api:
    proto: http
    addr: 3000
    schemes: [https]
